# Coiled Altar (Mythic), simulated for healers: Patchwerk's raid and calibration (everyone has the healer's health,
# every hit a share of it, one healer's share = 100%) on your Mythic kill's timeline and damage (8:15): P1 Venom
# Rupture waves after each Sever, P2 the Dreadful Presence aura, a 41 sec Spirit Erasure intermission, P3 both bosses
# with Venom Rupture waves; Suffocating Darkness and Defilement healing absorbs. The phase table
# is in engine/class_modules/bosses/sc_coiled_altar.cpp (coiled_altar_phases); phases=... after encounter= overrides it.
# Use after a healer profile: simc.exe <healer>.simc fights\coiled_altar.simc ...
max_time=496
vary_combat_length=0

# Stand-in raid, named after specs: 2 tanks, 3 healers (names only, they don't heal), 7 ranged, 7 melee.
# With the healer under test: 20 players, and it is the only one healing.
raid_tanks=2
raid_healers=3
raid_ranged=7
raid_melee=7
raid_health_from_healer=1
raid_tank_health_factor=1.44
raid_member_damage_reduction=0.10
raid_member_avoidance=0
# Tank mitigation as calibrated on the Vashnik kill: 35% on everything, another 57% on physical damage.
raid_tank_damage_reduction=0.35
raid_tank_physical_reduction=0.57

# Fury of the Dead (Venomous Abyss zone buff): +8% damage and healing in the week of 2026-11-08, +1% per week up to 15%.
encounter_healing_done=0.08
encounter=CoiledAltar
enemy_health=1000000000
