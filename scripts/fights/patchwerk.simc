# Patchwerk for healers: a generic test fight shaped like a real raid phase. Phase 1 of Mythic Coiled Altar as killed
# (2026-11-11, 2:12), looped for 5 min: steady rot (Coalesced Venom), spot damage (axes, pools, venoms), tank damage, and
# on the timeline Fangs of the Coiled Altar (a raid-wide burst, 2.45 stacks) at 0:01 and 1:25 of each loop and each
# Sever's Venom Rupture wave (10 sec, 0.209 H per stack per player) at 0:22, 0:39, 0:59, 1:16 (4 stacks), 1:47 (7: big)
# and 2:04 (3). Everyone has the healer's own max health (tanks x1.44) and every hit is a share of it, so the fight grows
# with the healer's gear and needs no update for a new season; the health is read once from the current gear, so every
# gear set faces the same fight. No zone buff and no dispels (Coiled Altar's own, in fights\coiled_altar.simc).
# A fight is its phases=... line: one phase per "<seconds>:key=value,...", separated by "/" (keys in
# engine/class_modules/bosses/sc_patchwerk.cpp): steady/spot/tank/avoidable multipliers, waves and raid bursts
# (at, sizes, stack, waves, big_from), healing absorbs (absorb_at, absorbs), group bursts (group_at, group_sizes,
# group_n). Change or add lines to model another fight.
# Use after a healer profile: simc.exe <healer>.simc fights\patchwerk.simc ...
max_time=300
vary_combat_length=0

# Stand-in raid, named after specs: 2 tanks, 3 healers (names only, they don't heal), 7 ranged, 7 melee.
# With the healer under test: 20 players, and it is the only one healing.
raid_tanks=2
raid_healers=3
raid_ranged=7
raid_melee=7
raid_health_from_healer=1
raid_tank_health_factor=1.44
raid_member_damage_reduction=0.10
raid_member_avoidance=0
# Tank mitigation as calibrated on the Vashnik kill: 35% on everything, another 57% on physical damage.
raid_tank_damage_reduction=0.35
raid_tank_physical_reduction=0.57

encounter=Patchwerk
dispellable=0
phases=132:steady=0.905,spot=0.852,avoidable=0,tank=0.38,waves=10,stack=0.209,big_from=7,at=1+22+39+59+76+85+107+124,sizes=2.45+4.2+4.2+4.2+4.2+2.45+7.2+3.2/132:steady=0.905,spot=0.852,avoidable=0,tank=0.38,waves=10,stack=0.209,big_from=7,at=1+22+39+59+76+85+107+124,sizes=2.45+4.2+4.2+4.2+4.2+2.45+7.2+3.2/132:steady=0.905,spot=0.852,avoidable=0,tank=0.38,waves=10,stack=0.209,big_from=7,at=1+22+39+59+76+85+107+124,sizes=2.45+4.2+4.2+4.2+4.2+2.45+7.2+3.2
enemy_health=1000000000
