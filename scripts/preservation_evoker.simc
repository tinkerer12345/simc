iterations=1000

evoker="Duskryth"
level=90
race=dracthyr
region=eu
server=silvermoon
role=heal
# SimC players have infinite health by default; healers must be able to die.
infinite_health=0
# Record the last 20 seconds before each death for the healer report's cause-of-death panel.
death_recap=20
professions=tailoring=100/enchanting=100
spec=preservation
# Mana from other players, per minute (tracked as its own mana gain): a Shaman's Mana Spring. No Source of Magic: you are the
# Evoker who casts it on someone else (add source_of_magic_mana_per_minute=6000 if your raid has a second Evoker).
mana_spring_mana_per_minute=3000
# This healer's role in the raid (measured 2026-11-16 on the Coiled Altar kill, Duskryth's healing and absorbs split by the kind
# of damage it answered): 20.2% of all damage; 15.3% of the tank damage, 20.5% of the steady, 21.8% of the raid bursts, 22.3%
# of the spot. Each kind weighted against the overall share: 100% = a normal Preservation Evoker's job in that raid.
encounter_damage_tank=0.759
encounter_damage_steady=1.016
encounter_damage_burst=1.081
encounter_damage_spot=1.106
# Duskryth's own talents (the saved "raid" loadout) and gear (SimC addon export, 2026-11-21)
talents=CwbBPJc41CfcseY0baneJ1IHrBAAAAAYmZwMjZYGzmhZmZbYAAgZMj5BMGzAmBAAAYmZGmxMzDMLzMDAmxMwCYBMDDwmhNDDgZmxA
set_bonus=midnight_season_2_2pc=1/midnight_season_2_4pc=1
omnium_talents=136814:1/136815:1/136817:1/136819:1/136822:1

