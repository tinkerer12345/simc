# Rotation from Silverblooms' Mythic kill log (casts per minute) and Silverblooms' play notes of 2026-10-25. injured_allies.<pct>,
# raid_health.pct and active_dot.rejuvenation are druid expressions added for this fork.
# Pre-pull: Lifebloom, Rejuvenation + Germination on yourself and on the tank (Protection_Warrior stands in for the
# Protection Paladin: the tank with low sustain; the Blood DK gets none)
# snapshot_stats: records the character sheet (gear, gems, enchants, buffs) for the report; it casts nothing.
actions.precombat=snapshot_stats
actions.precombat+=/lifebloom,target_self=1
actions.precombat+=/rejuvenation,target_self=1
actions.precombat+=/rejuvenation,target_self=1
actions.precombat+=/rejuvenation,target=Protection_Warrior
actions.precombat+=/rejuvenation,target=Protection_Warrior
# Heart of the Wild weave (finish it first once started): Cat Form, Heart of the Wild = empowered Feral Frenzy for 5
# combo points, Ferocious Bite at 5 for damage and Master Shapeshifter mana; the next heal shifts back. Started only
# while the raid is healthy. Never Convoke in a DPS form.
actions=variable,name=ramp,value=cooldown.tranquility.remains<15&encounter.big_burst.remains<15
# Convoke timing (2026-11-13): if a burst lands within 20 s, hold Convoke (and its opener) so it goes off in the last 5 s
# before it; otherwise on cooldown. Patchwerk +2.0% / +4.2% (0.3 s delay +1.8 / +4.1), Coiled Altar -0.2% (even: its waves
# come so often that holding gains nothing). Without the opener -2..-5%; 8 Rejuvenations first -0.8 / +1.1.
actions+=/variable,name=cgo,value=encounter.burst.remains<5|encounter.burst.remains>20
# Barkskin just before every big burst lands (good play, user 2026-11-09; also triggers Matted Fur and Flower Walk)
actions+=/barkskin,if=encounter.big_burst.remains<=1
# Tranquility as a big burst lands (Vashnik: an Imbibe's Expulsions; the ramp below sets it up), or in an emergency
actions+=/tranquility,if=encounter.big_burst.ago<3|raid_health.pct<60
actions+=/heart_of_the_wild,if=buff.cat_form.up
actions+=/ferocious_bite,if=buff.cat_form.up&combo_points>=5
# Feral Frenzy's 5 claws (one combo point each) land over 1 sec: stay in Cat Form until they have
actions+=/wait,sec=0.2,if=buff.cat_form.up&combo_points<5&cooldown.heart_of_the_wild.remains>115
actions+=/cat_form,if=cooldown.heart_of_the_wild.ready&raid_health.pct>=85&!buff.cat_form.up&cooldown.convoke_the_spirits.remains>10&mana.pct<=90&!variable.ramp&cooldown.tranquility.remains<165
actions+=/use_item,name=soulcoiler_ritual_vessel,if=injured_allies.80>=5
# Innervate always goes on yourself
actions+=/innervate,if=mana.pct<75
# Lifebloom on yourself (Photosynthesis blooms and Everbloom cleave), refreshed in the pandemic window
actions+=/lifebloom,target_self=1,if=refreshable
# Before every Convoke: Wild Growth, then Nature's Swiftness into Regrowth on yourself (Overgrowth refreshes your
# Lifebloom and adds Rejuvenation and Wild Growth on you)
actions+=/wild_growth,target_if=min:target.health.pct,if=cooldown.convoke_the_spirits.remains<=gcd.max*2&!buff.natures_swiftness.up&variable.cgo
# Hex Lord's Dooming Idol (when equipped; ignored otherwise): its Intellect right before every Convoke
actions+=/use_item,name=hex_lords_dooming_idol,if=cooldown.convoke_the_spirits.remains<=gcd.max*2&variable.cgo
actions+=/natures_swiftness,if=cooldown.convoke_the_spirits.remains<=gcd.max&variable.cgo
actions+=/regrowth,target_self=1,if=buff.natures_swiftness.up
actions+=/convoke_the_spirits,if=!buff.natures_swiftness.up&variable.cgo
# Tranquility ramp, from 15 sec before a big burst lands (encounter.big_burst.remains: the encounter's script)
# while Tranquility will be ready: dump Swiftmend charges but keep the last, Wild Growth, Regrowths until 5 are out
# (Rejuvenations from the filler), then Swiftmend the lowest ally with a HoT with the last charge and spread its Soul of
# the Forest Rejuvenation to 3 allies; Tranquility as the damage lands (Flourish extends every HoT by 2 sec per tick),
# then Regrowths (below).
# Swiftmend targets (sim test 2026-11-10): Blooming Frenzy blooms your Lifebloom 3 times on ANY Swiftmend (your log), so
# a self-Swiftmend only adds its vine to blooms 2-3 (~0.6k HPS of Everbloom) while it mostly overheals you; on the
# lowest ally with a HoT it adds ~8.6k effective HPS: limit +1.5..2 points, deaths about halved.
actions+=/swiftmend,target_if=min:target.health.pct+(!(dot.rejuvenation.ticking|dot.germination.ticking|dot.regrowth.ticking|dot.wild_growth.ticking))*1000,if=variable.ramp&encounter.big_burst.remains<=4
actions+=/rejuvenation,target_if=min:target.health.pct,if=variable.ramp&buff.soul_of_the_forest_tree.up
actions+=/swiftmend,target_if=min:target.health.pct,if=variable.ramp&encounter.big_burst.remains>4&charges>=2
actions+=/wild_growth,target_if=min:target.health.pct,if=variable.ramp
actions+=/regrowth,target_if=min:dot.regrowth.ticking*100+target.health.pct,if=variable.ramp&active_dot.regrowth<5
actions+=/rejuvenation,target_if=min:(dot.rejuvenation.ticking+dot.germination.ticking)*100+target.health.pct,if=variable.ramp&active_dot.rejuvenation<12
# Keeper of the Grove: Spirit of the Thicket makes Ironbark a big heal (its Dryad: ~107x spell power on the target over
# 6 s, the user's log), so on cooldown on the lowest ally. Without the talent: only to save someone below 40%.
actions+=/ironbark,target_if=min:target.health.pct,if=talent.spirit_of_the_thicket.enabled
actions+=/ironbark,target_if=min:target.health.pct,if=target.health.pct<40
# Exploding Infection (your 1 per wave): it gains a stack every tick and explodes on the raid when dispelled, so
# dispel at 2 stacks while the raid is healthy and let it reach 3 when the raid is low
actions+=/natures_cure,target_if=max:target.dispellable,if=target.dispellable>=3|target.dispellable>=2&raid_health.pct>=80
# Tree of Life (Reforestation, every 4th Swiftmend; Wild Growth hits 7): Wild Growth whenever ready with 3+ hurt (2026-11-13; the
# top EU log plays its windows the same way). Rejuvenation on anyone without one is the filler further down.
actions+=/wild_growth,target_if=min:target.health.pct,if=buff.incarnation_tree_of_life.up&injured_allies.90>=3
# One Rejuvenation on yourself and on the tank at all times (a second only once everyone nearby has one; 2026-11-12)
actions+=/rejuvenation,target_self=1,if=(dot.rejuvenation.refreshable|dot.germination.refreshable)&!dot.rejuvenation.ticking
actions+=/rejuvenation,target=Protection_Warrior,if=(dot.rejuvenation.refreshable|dot.germination.refreshable)&!dot.rejuvenation.ticking
# Swiftmend when charges are capping: the lowest ally with a HoT (a Regrowth first if none is out). Or spot heal
# someone low who has a HoT.
actions+=/swiftmend,target_if=min:target.health.pct+(!(dot.rejuvenation.ticking|dot.germination.ticking|dot.regrowth.ticking|dot.wild_growth.ticking))*1000,if=charges_fractional>=1.8
actions+=/regrowth,target_if=min:target.health.pct,if=cooldown.swiftmend.charges_fractional>=1.8
actions+=/swiftmend,target_if=min:target.health.pct,if=target.health.pct<50&(dot.rejuvenation.ticking|dot.germination.ticking|dot.regrowth.ticking|dot.wild_growth.ticking)
# Soul of the Forest Rejuvenation: Power of the Archdruid puts it on 3 allies
actions+=/rejuvenation,target_if=min:target.health.pct,if=buff.soul_of_the_forest_tree.up
actions+=/regrowth,target_if=min:target.health.pct,if=buff.clearcasting_tree.up
# In the Abundance window after a Convoke: Regrowth on hurt allies without one, Rejuvenation
# targets first (more Harmony), anyone low first of all
actions+=/regrowth,target_if=min:dot.regrowth.ticking*100+(target.health.pct>50)*50-dot.rejuvenation.ticking*20+target.health.pct*0.1,if=buff.abundance.up&cooldown.convoke_the_spirits.remains>45&target.health.pct<90
# Wild Growth whenever 5 or more are below 90%, at any mana, not held for Convoke (2026-11-12)
actions+=/wild_growth,target_if=min:target.health.pct,if=injured_allies.90>=5
# Low mana: fewer Rejuvenations, Regrowths with Abundance instead
actions+=/regrowth,target_if=min:target.health.pct,if=buff.abundance.up&(target.health.pct<45|mana.pct<30&target.health.pct<70)
# Starsurge while the raid is healthy: Master Shapeshifter returns more mana than it costs (10 casts on the kill)
# Tree of Life: Rejuvenation (40% stronger, 30% cheaper) on anyone without one, below everything but the Starsurge filler
actions+=/rejuvenation,target_if=min:(dot.rejuvenation.ticking+dot.germination.ticking)*100+target.health.pct,if=buff.incarnation_tree_of_life.up&!(dot.rejuvenation.ticking|dot.germination.ticking)
# Mana (2026-11-13): above 50% mana, Regrowth a hurt player without one before any filler. Coiled Altar +2.6% (half from its
# healing absorbs: Regrowth's upfront heal gets through), Patchwerk -0.5%; the user's style (filler only above 50%, Wrath
# when the raid is above 90%) ended fights at 44-51% mana and cost 3-4% on Patchwerk.
actions+=/regrowth,target_if=min:dot.regrowth.ticking*100+target.health.pct,if=target.health.pct<90&mana.pct>50
actions+=/starsurge,if=raid_health.pct>=95
# Rejuvenations in waves: always enough for Abundance (5), more while someone is hurt and mana allows
actions+=/rejuvenation,target_if=min:(dot.rejuvenation.ticking+dot.germination.ticking)*10+target.health.pct,if=(active_dot.rejuvenation<5|target.health.pct<95&mana.pct>=30)
# Downtime: Starsurge or Wrath (Master Shapeshifter mana) instead of waiting
actions+=/starsurge
actions+=/wrath

# Record raid frames (everyone's health and mana, and our HoTs) in the sample fight for the healer report.
raid_frames=1
