legs=,id=271527,enchant_id=7937,bonus_id=13334/6652/13693/13698/12854,redirected_base_stats=268225
# Silvermoon Agent's Sneakers (331)
feet=,id=244569,enchant_id=7993,bonus_id=12214/13667/12497/13751/14001/8960/12384/8793/13836,content_tuning=3615,crafted_stats=40/32,crafting_quality=5
# Vile Alchemist's Band (334)
finger1=,id=268249,enchant_id=7969,gem_id=240892,bonus_id=6652/13668/13335/12854
# Band of the Swarmcaller (334)
finger2=,id=281029,enchant_id=8025,gem_id=240900,bonus_id=6652/13668/13334/12854
